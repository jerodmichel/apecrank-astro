---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Send a Message">
  <main class="form-container">
    <header class="form-header">
      <h1>Send a Message</h1>
      <p>Fill out the form below and it will be routed directly to our inbox.</p>
    </header>

    <!-- Replace YOUR_ENDPOINT with your Formspree ID -->
    <form action="https://formspree.io/f/moeqprva" method="POST" class="contact-form">
      <div class="input-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required placeholder="How should we address you?" />
      </div>
      
      <div class="input-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" />
      </div>
      
      <div class="input-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required placeholder="How can we help you?"></textarea>
      </div>
      
      <button type="submit" class="submit-btn">Send Message</button>
    </form>

    <footer class="alt-contact">
      <p>Prefer instant messaging?</p>
      <div class="chat-links">
        <a href="https://t.me/YourUsername" target="_blank" rel="noopener noreferrer">Telegram</a>
        <span class="divider">|</span>
        <a href="https://wa.me/1234567890" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <span class="divider">|</span>
        <span class="wechat">WeChat: <strong>YourWeChatID</strong></span>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .form-container {
    max-width: 600px;
    margin: 4rem auto;
    padding: 0 1.5rem;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .form-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .form-header h1 {
    margin-bottom: 0.5rem;
    font-size: 2rem;
  }
  .form-header p {
    color: #666;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: #f9fafb;
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
  }
  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  label {
    font-weight: 600;
    font-size: 0.9rem;
    color: #374151;
  }
  input, textarea {
    padding: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: #2563eb;
    ring: 2px solid #bfdbfe;
  }
  .submit-btn {
    margin-top: 0.5rem;
    padding: 0.75rem;
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .submit-btn:hover {
    background-color: #1d4ed8;
  }
  .alt-contact {
    margin-top: 3rem;
    text-align: center;
    color: #4b5563;
    font-size: 0.9rem;
  }
  .chat-links {
    margin-top: 0.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .chat-links a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
  }
  .chat-links a:hover {
    text-decoration: underline;
  }
  .divider {
    color: #d1d5db;
  }
</style>